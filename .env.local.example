# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://taxap:taxap_dev_password@localhost:5432/taxap_dev?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Encrypts the AI keys users save in Settings (ADR-018). 32 random bytes in base64:
#   openssl rand -base64 32
# The server holds no AI key and reads no AI setting from here: each user sets up
# their own provider, key and model in the app. Without this secret Settings
# cannot save a key (so there is no AI). If it changes, saved keys become
# unreadable and users add theirs again.
ENCRYPTION_SECRET=""

# Admin bootstrap (optional -- creates/promotes this account on db:seed)
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD="a-strong-password"
